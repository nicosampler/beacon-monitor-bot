{
  "name": "@node-sentinel/beacon-monitor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "pnpm -r run start",
    "dev:bot": "pnpm --filter bot run dev",
    "dev:fetch:gnosis": "pnpm --filter fetch run dev:gnosis",
    "dev:fetch:ethereum": "pnpm --filter fetch run dev:ethereum",
    "xstate-logs": "pnpm --filter fetch run xstate-logs",
    "dev:api": "pnpm --filter api run dev",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "type-check": "pnpm -r exec tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "sync:apiTypes": "cp packages/api/src/routes/types.ts packages/bot/src/apiTypes.ts && cp packages/api/src/routes/types.ts packages/fetch/src/apiTypes.ts",
    "sync:env.ts": "cp master-env.ts packages/api/src/env.ts && cp master-env.ts packages/fetch/src/env.ts && cp master-env.ts packages/bot/src/env.ts",
    "env.dev.gnosis": "cp .env.dev.gnosis .env",
    "env.dev.ethereum": "cp .env.dev.ethereum .env",
    "env.prod.gnosis": "cp .env.prod.gnosis .env",
    "env.prod.ethereum": "cp .env.prod.ethereum .env",
    "clean-db": "pnpm dotenv -e .env.dev.ethereum tsx cleanDatabase.ts"
  },
  "dependencies": {
    "@prisma/client": "5.15.0",
    "xstate": "^5.20.2",
    "zod": "^3.25.61"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@t3-oss/env-core": "^0.9.2",
    "@types/node": "^22.17.2",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "pnpm": "^9.2.0",
    "prettier": "^3.2.5",
    "prisma": "5.15.0",
    "tsx": "^4.7.1",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.5.0"
  }
}
