{
  "compilerOptions": {
    "module": "nodenext",
    "target": "ES2022",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@/*": ["*"]
    },
    "skipLibCheck": true,
    "types": ["jest"]
  },
  "include": ["./src/**/*"],
  "exclude": ["node_modules", "dist"]
}
