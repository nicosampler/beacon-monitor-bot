generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Epoch {
  epoch          Int     @id
  rewardsFetched Boolean // Whether the rewards for this epoch have been fetched
}

model Slot {
  slot                Int         @id
  attestationsFetched Boolean // Whether the attestations for this slot have been fetched
  committee           Committee[]

  @@index([attestationsFetched, slot])
}

model Committee {
  slot                 Int
  index                Int // indicates what position in the epoch this slot is in
  aggregationBitsIndex Int // indicates what position in the aggregation bits this validator was assigned to
  validatorIndex       Int
  attestationDelay     Int?

  slot_relation Slot @relation(fields: [slot], references: [slot], onDelete: Cascade)

  @@id([slot, index, validatorIndex])
  @@index([slot, validatorIndex]) // TODO: add why is each index needed
  @@index([slot, index])
  @@index([validatorIndex])
  @@index([slot, attestationDelay])
  @@index([slot]) // used to remove processed committee records
}

model Validator {
  id                Int     @id
  status            String?
  balance           Decimal @db.Decimal(78, 0)
  withdrawalAddress String?
  users             User[]

  @@index([withdrawalAddress])
}

model ExecutionRewards {
  address     String
  timestamp   DateTime
  amount      Decimal  @db.Decimal(78, 0)
  blockNumber Int

  @@id(blockNumber)
  @@index([timestamp])
}

model HourlyValidatorStats {
  validatorIndex     Int
  hour               Int // 0-23
  date               DateTime @db.Date // dd-mm-yyyy
  head               BigInt?
  target             BigInt?
  source             BigInt?
  inactivity         BigInt?
  attestationsMissed Int?

  @@id([validatorIndex, hour, date])
  @@index([date, hour])
}

model HourlyExecutionRewards {
  address String
  amount  Decimal  @db.Decimal(78, 0)
  hour    Int // 0-23
  date    DateTime @db.Date // dd-mm-yyyy

  @@id([address, date, hour])
  @@index([date, hour])
}

model DailyValidatorStats {
  validatorIndex     Int
  date               DateTime @db.Date
  executionRewards   Decimal  @db.Decimal(78, 0)
  beaconRewards      Decimal  @db.Decimal(78, 0)
  attestationsMissed Int

  @@id([validatorIndex, date])
  @@index([date])
}

model WeeklyValidatorStats {
  validatorIndex     Int
  week               Int // 1-53
  year               Int
  executionRewards   Decimal @db.Decimal(78, 0)
  beaconRewards      Decimal @db.Decimal(78, 0)
  attestationsMissed Int

  @@id([validatorIndex, week, year])
  @@index([year, week])
}

model MonthlyValidatorStats {
  validatorIndex     Int
  month              Int // 1-12
  year               Int
  executionRewards   Decimal @db.Decimal(78, 0)
  beaconRewards      Decimal @db.Decimal(78, 0)
  attestationsMissed Int

  @@id([validatorIndex, month, year])
  @@index([year, month])
}

model YearlyValidatorStats {
  validatorIndex     Int
  year               Int
  executionRewards   Decimal @db.Decimal(78, 0)
  beaconRewards      Decimal @db.Decimal(78, 0)
  attestationsMissed Int

  @@id([validatorIndex, year])
  @@index([year])
}

model LastSummaryUpdate {
  id                    Int       @id @default(autoincrement())
  hourlyValidatorStats  DateTime?
  dailyValidatorStats   DateTime?
  weeklyValidatorStats  DateTime?
  monthlyValidatorStats DateTime?
  yearlyValidatorStats  DateTime?
}

model User {
  id                   BigInt              @id
  userId               BigInt              @unique
  chatId               BigInt              @unique
  username             String              @unique
  messageId            BigInt?
  lastClaimed          DateTime?
  statusNofi           DateTime?
  performanceNotif     DateTime?
  performanceThreshold Int                 @default(90)
  attestationsNotif    DateTime?
  attestationThreshold Int                 @default(5)
  validators           Validator[]
  withdrawalAddresses  WithdrawalAddress[]
  feeRewardAddresses   FeeRewardAddress[]
}

model WithdrawalAddress {
  address String @id
  users   User[]
}

model FeeRewardAddress {
  address String @id
  users   User[]
}
